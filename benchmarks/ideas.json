{
  "description": "Standard test ideas for skill-quality regression. Each entry: the prompt an agent receives, and properties a compliant report MUST exhibit. Scoring: see rubric.md.",
  "version": "1.1.0",
  "cases": [
    {
      "id": "epidemic-threshold",
      "prompt": "Model this idea mathematically: a new contagious disease appears in a city of 1 million people.",
      "must_contain": ["R0", "SIR", "threshold", "falsif", "assumption"],
      "expected_archetype": "SIR",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "barista-staffing",
      "prompt": "Model this idea mathematically: a coffee shop must decide how many baristas to schedule each hour.",
      "must_contain": ["Erlang", "M/M/c", "integer program|ILP|optimization", "cliff|nonlinear"],
      "expected_archetype": "M/M/c queueing",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "app-adoption-ceiling",
      "prompt": "Model this idea mathematically: our new app's signups are growing fast; how big can it get and when will growth stall?",
      "must_contain": ["Bass|logistic", "ceiling|carrying capacity|K ", "calibrat"],
      "expected_archetype": "Bass diffusion / logistic",
      "min_lenses_built": 2,
      "must_reject_at_least_one": false
    },
    {
      "id": "duopoly-price-cut",
      "prompt": "Model this idea mathematically: two cafes face each other; one considers cutting prices 20 percent.",
      "must_contain": ["Nash|best response", "prisoner|dilemma|war", "repeated|patience|discount"],
      "expected_archetype": "Bertrand duopoly",
      "min_lenses_built": 1,
      "must_reject_at_least_one": true
    },
    {
      "id": "reserve-ruin",
      "prompt": "Model this idea mathematically: is a shared insurance reserve enough to survive a bad decade of flood claims?",
      "must_contain": ["Monte Carlo|simulation", "tail|risk", "surplus|reserve|Cramer|Lundberg"],
      "expected_archetype": "compound Poisson / ruin theory",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "greenhouse-setpoint",
      "prompt": "Model this idea mathematically: my greenhouse gets too cold at night for seedlings.",
      "must_contain": ["setpoint|feedback|hysteresis", "feasib", "disturbance"],
      "expected_archetype": "feedback control / Newton cooling",
      "min_lenses_built": 2,
      "must_reject_at_least_one": false
    },
    {
      "id": "school-rumor-reach",
      "prompt": "Model this idea mathematically: a rumor spreads through an 800-student high school; how far does it get by Friday?",
      "must_contain": ["degree|hub|network", "k2|<k2>|heterogen"],
      "expected_archetype": "rumor dynamics on networks",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "ad-lift-causal",
      "prompt": "Model this idea mathematically: users exposed to retargeting ads buy three times more; should we raise that budget?",
      "must_contain": ["confound", "DAG|backdoor|propensity", "experiment|holdout|sensitivity"],
      "expected_archetype": "causal identification",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "physics-pendulum-drift",
      "prompt": "Model this idea mathematically: a damped pendulum's period drifts as amplitude decays.",
      "must_contain": ["period|frequency|\\bT\\b", "damp|decay|Q-factor", "nonlinear|amplitude|sine"],
      "expected_archetype": "damped harmonic oscillator",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true,
      "numeric_oracle": {"keyword": "period", "expected": 2.0, "tolerance": 0.3}
    },
    {
      "id": "chemistry-batch-yield",
      "prompt": "Model this idea mathematically: a batch reactor's yield depends on temperature and residence time.",
      "must_contain": ["yield|conversion", "Arrhenius|kinetics|rate", "CSTR|batch|reactor"],
      "expected_archetype": "batch reactor kinetics",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true,
      "numeric_oracle": {"keyword": "yield", "expected": 0.85, "tolerance": 0.1}
    },
    {
      "id": "biology-predator-prey",
      "prompt": "Model this idea mathematically: wolves and deer share an island; deer grow fast but wolves starve without prey.",
      "must_contain": ["Lotka|Volterra", "predator|wolf", "prey|deer|rabbit", "coupled|equilibrium|oscil"],
      "expected_archetype": "Lotka-Volterra predator-prey",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "physics-heat-conduction",
      "prompt": "Model this idea mathematically: a 50W LED bulb in an aluminum housing reaches thermal equilibrium with 25C ambient air; estimate the steady-state temperature rise.",
      "must_contain": ["Fourier|heat conduction|thermal", "steady|equilibrium|Newton", "thermal resistance|convection|Biot"],
      "expected_archetype": "steady-state heat conduction",
      "min_lenses_built": 2,
      "must_reject_at_least_one": false,
      "numeric_oracle": {"keyword": "temperature|rise|delta|dT", "expected": 50, "tolerance": 30}
    },
    {
      "id": "operations-inventory",
      "prompt": "Model this idea mathematically: a store stocks a product with uncertain demand; how often should it reorder to avoid stockouts without overstock?",
      "must_contain": ["EOQ|economic order", "newsvendor|(Q,R)|base-stock|safety stock", "Poisson|normal|demand", "holding|stockout|service level"],
      "expected_archetype": "EOQ inventory optimization",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "chemistry-equilibrium",
      "prompt": "Model this idea mathematically: nitrogen and hydrogen react to form ammonia in a Haber process reactor at high pressure.",
      "must_contain": ["equilibrium|K_eq|K", "stoichiometr", "Le Chatelier", "pressure|shift|equilibrium"],
      "expected_archetype": "chemical equilibrium",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true,
      "numeric_oracle": {"keyword": "K|constant|ratio", "expected": 0.06, "tolerance": 0.05}
    },
    {
      "id": "causal-confounding",
      "prompt": "Model this idea mathematically: ice cream sales and drowning deaths rise together in summer; does ice cream cause drownings?",
      "must_contain": ["confound|third variable|spurious", "DAG|backdoor|covariate|adjust", "season|temperature|humidity", "correlation != causation|causal"],
      "expected_archetype": "confounding bias",
      "min_lenses_built": 2,
      "must_reject_at_least_one": false
    },
    {
      "id": "physics-oscillator-ringdown",
      "prompt": "Model this idea mathematically: after a crowd leaves a footbridge, the deck keeps wobbling with a 2 s period and each swing's amplitude halves every 10 s; how quickly do the wobbles die and how much damping would shorten that?",
      "must_contain": ["damped|damping|second-order", "natural frequency|period|eigen", "logarithmic decrement|decay rate|quality factor", "sensitivity|parameter"],
      "expected_archetype": "damped harmonic oscillator",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true,
      "numeric_oracle": {"keyword": "decay rate|damping rate|gamma|attenuation", "expected": 0.069, "tolerance": 0.02}
    },
    {
      "id": "biology-drug-dosing",
      "prompt": "Model this idea mathematically: after a pill, the drug level in blood jumps to 40 mg/L and halves every 6 hours; the drug stops working below 5 mg/L and becomes harmful above 60 mg/L - when should the next dose come?",
      "must_contain": ["half-life|elimination|exponential", "compartment", "therapeutic window|minimum effective|toxic", "interval|schedule|dose"],
      "expected_archetype": "one-compartment pharmacokinetics",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "chemistry-catalyst-deactivation",
      "prompt": "Model this idea mathematically: a reactor catalyst loses about 5 percent of its activity every month, and below 60 percent activity the product spec fails; when should the plant replace or regenerate the catalyst?",
      "must_contain": ["deactivat|activity decay|fouling", "exponential|first-order|decay", "threshold|specification|constraint", "replacement|regeneration|schedule|optimal"],
      "expected_archetype": "catalyst deactivation kinetics",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    },
    {
      "id": "operations-airline-overbooking",
      "prompt": "Model this idea mathematically: an airline sells 205 tickets for a 200-seat plane and each passenger independently shows up with probability 0.95; how many passengers show up on average and what is the overbooking risk?",
      "must_contain": ["binomial|no-show|show-up", "expected value|expectation|mean", "newsvendor|critical fractile|service level|oversale", "probability.*(exceed|over|bump)|risk"],
      "expected_archetype": "binomial overbooking / newsvendor",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true,
      "numeric_oracle": {"keyword": "expected.*(show|arrive|passenger)|mean.*(show|passenger)", "expected": 194.75, "tolerance": 1.0}
    },
    {
      "id": "causal-training-productivity",
      "prompt": "Model this idea mathematically: employees who enjoyed math at school volunteered for our analytics training, and their productivity rose; did the training cause the gain?",
      "must_contain": ["selection bias|self-selection|confound", "counterfactual|potential outcome|control group", "propensity|matching|IPW|difference-in-differences|DAG|backdoor", "assumption|identif"],
      "expected_archetype": "program evaluation under selection bias",
      "min_lenses_built": 2,
      "must_reject_at_least_one": true
    }
  ]
}
